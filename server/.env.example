# DNS domain pointing at the deployment VPS, for automatic HTTPS.
JARVIS_DOMAIN=ai.example.com

# Backend-only secrets. Never commit or paste a real OpenRouter API key into an APK.
HOST=127.0.0.1
PORT=8080
OPENROUTER_API_KEY=REPLACE_IN_SERVER_SECRET_MANAGER
OPENROUTER_MODEL=REPLACE_WITH_APPROVED_MODEL_ID
REDIS_URL=redis://127.0.0.1:6379

# Invite-only test access: the server generates one-use invites. A tester
# activates Jarvis once and receives a revocable 90-day token. No provider key
# is supplied to tester phones. NEVER enable for public/anonymous launch.
BETA_INVITES_ENABLED=false

# Two private test accounts, separately revocable, each with a 256-bit random token.
# Supply a JSON mapping id -> SHA-256 hex digest of the corresponding raw token.
# Legacy per-tester tokens are optional when beta invitations are enabled.
# Never put a genuine value into this tracked example file.
TESTER_TOKEN_SHA256_JSON={}

# Optional production OIDC auth (if enabled, ALL three fields are required).
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=

# Default: PRIVATE TEST. Before any public customer traffic, set true and
# configure a real OIDC issuer, audience and JWKS; tester bypass must be empty.
# A public service also needs account registration, a real subscription/billing
# verification source, privacy/terms pages, telemetry and verified deletion.
PUBLIC_LAUNCH_ENABLED=false
