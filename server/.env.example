# Configure these in the backend secret manager. Never commit real API keys.
HOST=127.0.0.1
PORT=8080
OPENROUTER_API_KEY=REPLACE_IN_DEPLOYMENT_SECRET_MANAGER
OPENROUTER_MODEL=REPLACE_WITH_APPROVED_MODEL_ID
OIDC_ISSUER=https://YOUR_OIDC_ISSUER
OIDC_AUDIENCE=jarvis-mobile-gateway
OIDC_JWKS_URL=https://YOUR_OIDC_ISSUER/.well-known/jwks.json
REDIS_URL=redis://127.0.0.1:6379
