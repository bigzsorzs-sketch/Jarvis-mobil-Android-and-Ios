<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Never transfer voice preferences, cached message/access settings, health readings,
         contacts-related state, invoices or local encryption metadata to another device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
